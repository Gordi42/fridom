HloModule <m> is_scheduled=true, entry_computation_layout={(f64[9]{0})->f64[9]{0}}, allow_spmd_sharding_propagation_to_output={true}, num_partitions=4
%wrapped_slice_computation (param_0: f64[9]) -> f64[2] {
  %param_0 = f64[9]{0} parameter(0)
  ROOT %slice.5 = f64[2]{0} slice(%param_0), slice={[4:6]}, metadata={op_name="jit(<lambda>)/shard_map/dynamic_slice" stack_frame_id=<n>}
}

%wrapped_slice_computation.1 (param_0.1: f64[9]) -> f64[2] {
  %param_0.1 = f64[9]{0} parameter(0)
  ROOT %slice.6 = f64[2]{0} slice(%param_0.1), slice={[2:4]}, metadata={op_name="jit(<lambda>)/shard_map/slice" stack_frame_id=<n>}
}

ENTRY %main.2_spmd (param.1: f64[9]) -> f64[9] {
  %param.1 = f64[9]{0} parameter(0), sharding={devices=[4]<=[4]}, metadata={op_name="s"}
  %constant.4.clone.1 = s64[] constant(0), metadata={op_name="jit(<lambda>)/shard_map" stack_frame_id=<n>}
  %constant.20 = s64[] constant(6), metadata={op_name="jit(<lambda>)/shard_map/select_n" stack_frame_id=<n>}
  %copy.2 = f64[9]{0} copy(%param.1)
  %wrapped_slice.1 = f64[2]{0} fusion(%param.1), kind=kLoop, calls=%wrapped_slice_computation.1, metadata={op_name="jit(<lambda>)/shard_map/slice" stack_frame_id=<n>}
  %wrapped_slice = f64[2]{0} fusion(%param.1), kind=kLoop, calls=%wrapped_slice_computation, metadata={op_name="jit(<lambda>)/shard_map/dynamic_slice" stack_frame_id=<n>}
  %ppermute.7 = f64[2]{0} collective-permute(%wrapped_slice.1), channel_id=1, source_target_pairs={{0,3},{1,0},{2,1},{3,2}}, metadata={op_name="jit(<lambda>)/shard_map/ppermute" stack_frame_id=<n>}
  %ppermute.6 = f64[2]{0} collective-permute(%wrapped_slice), channel_id=1, source_target_pairs={{0,1},{1,2},{2,3},{3,0}}, metadata={op_name="jit(<lambda>)/shard_map/ppermute" stack_frame_id=<n>}
  %dynamic_update_slice.6 = f64[9]{0} dynamic-update-slice(%copy.2, %ppermute.6, %constant.4.clone.1), metadata={op_name="jit(<lambda>)/shard_map/dynamic_update_slice" stack_frame_id=<n>}
  ROOT %dynamic_update_slice.7 = f64[9]{0} dynamic-update-slice(%dynamic_update_slice.6, %ppermute.7, %constant.20), metadata={op_name="jit(<lambda>)/shard_map/dynamic_update_slice" stack_frame_id=<n>}
}
